{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/invitations/create", "destination": "/api/invitations/create" },
    { "source": "/api/invitations/:token", "destination": "/api/invitations/[token]" },
    { "source": "/api/users/create", "destination": "/api/users/create" },
    { "source": "/api/users/login", "destination": "/api/users/login" },
    { "source": "/api/users/create-from-invitation", "destination": "/api/users/create-from-invitation" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}