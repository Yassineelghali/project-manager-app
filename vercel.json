{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    { "src": "/api/invitations/create", "dest": "/api/invitations/create" },
    { "src": "/api/invitations/([^/]+)", "dest": "/api/invitations/[token]" },
    { "src": "/api/users/create-from-invitation", "dest": "/api/users/create-from-invitation" },
    { "src": "/api/users/create", "dest": "/api/users/create" },
    { "src": "/api/users/login", "dest": "/api/users/login" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
